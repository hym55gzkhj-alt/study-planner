# Kopiere diese Datei nach ".env" und passe die Werte an.
# Die Datei .env wird NICHT ins Git-Repository eingecheckt.

# Adresse und Port des lokalen Servers (127.0.0.1 = nur von diesem Computer erreichbar)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Zeitzone für "heute", Countdown und die 07:00-Uhr-Begrüßung
JARVIS_TZ=Europe/Berlin

# Speicherort der SQLite-Datenbank (relativ zum jarvis-Ordner)
JARVIS_DB_PATH=data/jarvis.db

# Schlüssel für den KI-Lernpartner (https://console.anthropic.com → API Keys).
# Ohne Schlüssel beantwortet JARVIS nur Fragen zu deinen Klausuren und Aufgaben.
# Niemals direkt in den Code schreiben!
ANTHROPIC_API_KEY=

# Optional: Modell und Denkaufwand (low | medium | high)
JARVIS_AI_MODEL=claude-opus-5-5
JARVIS_AI_EFFORT=low
